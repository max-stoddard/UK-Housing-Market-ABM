# Author: Max Stoddard

# Keep public API images on an explicit allowlist. The Docker build context is
# the repository root, so this prevents private, generated, and local-only
# material from entering the context or image.
*

!dashboard/
dashboard/*
!dashboard/package.json
!dashboard/package-lock.json
!dashboard/tsconfig.server.json
!dashboard/server/
!dashboard/server/**
!dashboard/shared/
!dashboard/shared/**
dashboard/release/
dashboard/release/**

!input-data-versions/
!input-data-versions/**
input-data-versions/v[0-9]*/
!input-data-versions/v0/
!input-data-versions/v0/**
!input-data-versions/v0oo/
!input-data-versions/v0oo/**
!input-data-versions/v4.4/
!input-data-versions/v4.4/**
!input-data-versions/v4.19/
!input-data-versions/v4.19/**
input-data-versions/calibration-evidence/
input-data-versions/calibration-evidence/**
input-data-versions/validation-sources/
input-data-versions/validation-sources/**
input-data-versions/tmp/
input-data-versions/tmp/**
