!dashboard/package.json
!dashboard/package-lock.json
!dashboard/tsconfig.server.json
!dashboard/server/
!dashboard/server/**
!dashboard/shared/
!dashboard/shared/**

!input-data-versions/
!input-data-versions/**
input-data-versions/calibration-evidence/
input-data-versions/calibration-evidence/**
input-data-versions/validation-sources/
input-data-versions/validation-sources/**
input-data-versions/tmp/
input-data-versions/tmp/**
